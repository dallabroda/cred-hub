  {
   "fieldname": "title_defaults_section",
   "fieldtype": "Section Break",
   "label": "Title defaults",
   "depends_on": "eval:doc.cenprot_enabled"
  },
  {
   "fieldname": "default_species",
   "fieldtype": "Select",
