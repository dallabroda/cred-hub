 "fields": [
  {
   "fieldname": "assertiva_section",
   "fieldtype": "Section Break",
   "label": "Assertiva Localize"
  },
  {
   "fieldname": "assertiva_enabled",
   "fieldtype": "Check",
   "label": "Enable Assertiva Localize",
   "description": "Find the partners of an organization with phones (WhatsApp) and e-mails. Each query is paid to Assertiva by your company."
  },
  {
   "fieldname": "assertiva_client_id",
   "fieldtype": "Data",
   "label": "Assertiva Client ID",
   "depends_on": "eval:doc.assertiva_enabled",
   "mandatory_depends_on": "eval:doc.assertiva_enabled"
  },
  {
   "fieldname": "assertiva_client_secret",
   "fieldtype": "Password",
   "label": "Assertiva Client Secret",
   "depends_on": "eval:doc.assertiva_enabled",
   "mandatory_depends_on": "eval:doc.assertiva_enabled"
  },
  {
   "fieldname": "assertiva_column",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "assertiva_purpose",
   "fieldtype": "Select",
   "label": "LGPD purpose of the queries",
   "options": "Credit protection and collection\nIdentity confirmation and fraud prevention",
   "default": "Credit protection and collection",
   "depends_on": "eval:doc.assertiva_enabled"
  },
  {
   "fieldname": "assertiva_partner_lookup",
   "fieldtype": "Check",
   "label": "Also look up each partner's phones and e-mails",
   "default": "0",
   "depends_on": "eval:doc.assertiva_enabled",
   "description": "One more paid query per partner, paid by your company. Off until an admin turns it on."
  },
  {
   "fieldname": "assertiva_cache_days",
   "fieldtype": "Int",
   "label": "Reuse a query for (days)",
   "default": "30",
   "non_negative": 1,
   "depends_on": "eval:doc.assertiva_enabled",
   "description": "Within this period the saved result is used at no cost, unless someone asks for a new paid query."
  },
  {
   "fieldname": "cenprot_section",
   "fieldtype": "Section Break",
   "label": "CENPROT (protest at the registry)"
  },
  {
   "fieldname": "cenprot_enabled",
   "fieldtype": "Check",
   "label": "Enable CENPROT",
   "description": "Send overdue titles of the collection pipeline to protest and follow them at the registry. Your company's own IEPTB contract."
  },
  {
   "fieldname": "cenprot_environment",
   "fieldtype": "Select",
   "label": "CENPROT environment",
   "options": "Homologation\nProduction",
   "default": "Homologation",
   "depends_on": "eval:doc.cenprot_enabled"
  },
  {
   "fieldname": "cenprot_username",
   "fieldtype": "Data",
   "label": "CENPROT username",
   "depends_on": "eval:doc.cenprot_enabled",
   "mandatory_depends_on": "eval:doc.cenprot_enabled"
  },
  {
   "fieldname": "cenprot_password",
   "fieldtype": "Password",
   "label": "CENPROT password",
   "depends_on": "eval:doc.cenprot_enabled",
   "mandatory_depends_on": "eval:doc.cenprot_enabled"
  },
  {
   "fieldname": "cenprot_column",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "cenprot_presenter_code",
   "fieldtype": "Data",
   "label": "Presenter code",
   "depends_on": "eval:doc.cenprot_enabled",
   "description": "Only when IEPTB gave one (tag apresentante)."
  },
  {
   "fieldname": "cenprot_bearer_code",
   "fieldtype": "Data",
   "label": "Bearer code",
   "depends_on": "eval:doc.cenprot_enabled",
   "description": "Only when IEPTB gave one (tag codPortador)."
  },
  {
   "fieldname": "cenprot_bearer_name",
